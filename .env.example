# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Allowed Telegram User IDs (comma-separated integers)
# Example: 123456789,987654321
ALLOWED_TELEGRAM_USER_IDS="123456789"

# LLM Configuration (OpenAI or any OpenAI-compatible provider)
OPENAI_API_KEY="your_llm_api_key_here"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o"

# Dual-Tier Model Configuration (Fast / Smart Strategy)
# OPENAI_FAST_MODEL: Model cepat & hemat untuk obrolan kasual & kontrol sistem (e.g. gpt-4o-mini, gemini-2.5-flash, llama-3.3-70b-versatile)
# OPENAI_SMART_MODEL: Model cerdas & reasoning tinggi untuk tugas dev rumit & analisis (e.g. gpt-4o, claude-3-5-sonnet)
OPENAI_FAST_MODEL="gpt-4o-mini"
OPENAI_SMART_MODEL="gpt-4o"

# Security & Execution Settings
SECURITY_CONFIRMATION_TIMEOUT=60
ENABLE_ROOT_COMMANDS=true
COMMAND_TIMEOUT=30
LOG_LEVEL="WARNING"
